root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{cs,vb}]
# CS1591: Missing XML comment for publicly visible type or member (SA1600/SA1601/SA1602 cover this with more nuance)
dotnet_diagnostic.CS1591.severity = none
# SA1000: Keywords should be spaced correctly
dotnet_diagnostic.SA1000.severity = none
# SA1101: Prefix local calls with this
dotnet_diagnostic.SA1101.severity = none
# SA1010: Opening square brackets or parentheses should be spaced correctly
dotnet_diagnostic.SA1010.severity = none
# SA1600: Elements should be documented
dotnet_diagnostic.SA1600.severity = warning
# SA1601: Partial elements should be documented
dotnet_diagnostic.SA1601.severity = warning
# SA1633: File should have header
dotnet_diagnostic.SA1633.severity = none
# SA1309: Field names should not begin with underscore
dotnet_diagnostic.SA1309.severity = none
# SA1602: Enumeration items should be documented
dotnet_diagnostic.SA1602.severity = warning
# IDE1006 Naming rule violation: private fields must begin with an underscore (see naming rule below)
dotnet_diagnostic.IDE1006.severity = warning

# Private const fields use PascalCase, not an underscore prefix - they're compile-time constants, not variables.
dotnet_naming_rule.private_const_fields_pascal_case.severity = warning
dotnet_naming_rule.private_const_fields_pascal_case.symbols = private_const_fields
dotnet_naming_rule.private_const_fields_pascal_case.style = pascal_case_style

dotnet_naming_symbols.private_const_fields.applicable_kinds = field
dotnet_naming_symbols.private_const_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_const_fields.required_modifiers = const

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# All other private (instance or static) fields are prefixed with an underscore.
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_prefix.capitalization = camel_case
dotnet_naming_style.underscore_prefix.required_prefix = _
# IDE0290: Use primary constructor
csharp_style_prefer_primary_constructors = false:suggestion
# CA1707: Identifiers should not contain underscores (Unit Test method names often use underscores)
dotnet_diagnostic.CA1707.severity = none
# MA0004: Use Task.ConfigureAwait(false)
dotnet_diagnostic.MA0004.severity = none
# MA0051: Method is too long
dotnet_diagnostic.MA0051.severity = none
# SA1402: File may only contain a single type
dotnet_diagnostic.SA1402.severity = error
# IDE0051: Remove unused private members (methods, fields, properties)
dotnet_diagnostic.IDE0051.severity = warning
# CA1848: Use the LoggerMessage delegates
dotnet_diagnostic.CA1848.severity = none
# CA1305: Specify IFormatProvider
dotnet_diagnostic.CA1305.severity = none

[*.feature.cs]
# SA1518: The line endings at the end of a file do not match the settings for the project.
dotnet_diagnostic.SA1518.severity = none

[src/Wizdle.Api/Program.cs]
# MA0036: Make class static - needs to be non-static for WebApplicationBuilder and WebApplication
dotnet_diagnostic.MA0036.severity = none

[tests/functional/Wizdle.Web.Functional.Tests/Hooks/BrowserHook.cs]
# MA0182: Discovered and invoked reflectively by Reqnroll via the [Binding] attribute, so the analyzer can't see the real usage.
dotnet_diagnostic.MA0182.severity = none

[tests/functional/Wizdle.Web.Functional.Tests/Hooks/ContainerHook.cs]
# MA0182: Discovered and invoked reflectively by Reqnroll via the [Binding] attribute, so the analyzer can't see the real usage.
dotnet_diagnostic.MA0182.severity = none

[tests/functional/Wizdle.Web.Functional.Tests/Steps/AccessibilityTestingSteps.cs]
# MA0182: Discovered and invoked reflectively by Reqnroll via the [Binding] attribute, so the analyzer can't see the real usage.
dotnet_diagnostic.MA0182.severity = none

[tests/functional/Wizdle.Web.Functional.Tests/Steps/BrowserSteps.cs]
# MA0182: Discovered and invoked reflectively by Reqnroll via the [Binding] attribute, so the analyzer can't see the real usage.
dotnet_diagnostic.MA0182.severity = none

[tests/functional/Wizdle.Web.Functional.Tests/Steps/HomePageSteps.cs]
# MA0182: Discovered and invoked reflectively by Reqnroll via the [Binding] attribute, so the analyzer can't see the real usage.
dotnet_diagnostic.MA0182.severity = none

[src/Wizdle.Discord/WizdleApiClient.cs]
# MA0038: Uses the primary-constructor-captured httpClient instance, so it cannot be made static.
dotnet_diagnostic.MA0038.severity = none

[src/Wizdle.Web/WizdleHttpClient.cs]
# MA0038: Uses the primary-constructor-captured httpClient instance, so it cannot be made static.
dotnet_diagnostic.MA0038.severity = none

[tests/**/*.cs]
# SA0001: All diagnostics of XML documentation comments has been disabled due to the current project configuration.
dotnet_diagnostic.SA0001.severity = none
# SA1600: Elements should be documented
dotnet_diagnostic.SA1600.severity = none
# SA1601: Partial elements should be documented
dotnet_diagnostic.SA1601.severity = none
# SA1602: Enumeration items should be documented
dotnet_diagnostic.SA1602.severity = none
